---
import "@/styles/global.css";
import { ScrollProgress } from "@/components/ui/scroll-progress";
import StarsCanvas from "@/components/ui/StarBackground";
import { DockBar } from "@/components/DockBar";
import { Toaster } from "@/components/ui/sonner";
import SplashCursor from "../ui/Animations/SplashCursor/SplashCursor";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: "website" | "article" | "profile";
  publishDate?: Date;
  updatedDate?: Date;
  keywords?: string;
  faqs?: Array<{ question: string; answer: string }>;
  breadcrumbs?: Array<{ name: string; url: string }>;
  showEffects?: boolean;
}

const {
  title,
  description,
  image,
  canonicalUrl,
  type = "website",
  publishDate,
  updatedDate,
  keywords,
  faqs,
  breadcrumbs,
  showEffects = false,
} = Astro.props;

const SITE_URL = "https://noureddinedriouech.me";
const pageTitle = title
  ? `${title} | Noureddine Driouech`
  : "Noureddine Driouech | AI Software Engineer & Full-Stack Architect";
const pageDescription =
  description ||
  "Official portfolio of Noureddine Driouech — AI Software Engineer & Full-Stack Systems Architect specializing in Generative AI, Local RAG pipelines, React/Next.js SaaS, and web automation.";
const pageImage = image
  ? image.startsWith("http")
    ? image
    : `${SITE_URL}${image.startsWith("/") ? "" : "/"}${image}`
  : `${SITE_URL}/NoureddineDRIOUECH.jpg`;
const pageCanonical = canonicalUrl || new URL(Astro.url.pathname, Astro.site || SITE_URL).href;

const defaultKeywords =
  "Noureddine Driouech, Noureddine DRIOUECH, Nour Driouech, Driouech Noureddine, N. Driouech, n driouech, AI Software Engineer, AI Engineer Morocco, AI Engineer Casablanca, RAG Engineer, Local LLMs, Full-Stack Developer, React Developer, Next.js, Python Developer, Web Automation, SaaS Architecture, Morocco Software Engineer";
const pageKeywords = keywords ? `${keywords}, ${defaultKeywords}` : defaultKeywords;

// Build multi-entity Schema.org JSON-LD @graph
const schemaGraph: any[] = [
  {
    "@type": "Person",
    "@id": `${SITE_URL}/#person`,
    "name": "Noureddine DRIOUECH",
    "alternateName": [
      "Noureddine Driouech",
      "Nour Driouech",
      "Driouech Noureddine",
      "N. Driouech",
      "n driouech",
      "Noureddine",
      "Driouech",
      "Noureddine Driouech AI Engineer",
      "Noureddine Driouech Casablanca",
      "Noureddine Driouech Morocco"
    ],
    "url": `${SITE_URL}/`,
    "image": `${SITE_URL}/NoureddineDRIOUECH.jpg`,
    "jobTitle": ["AI Software Engineer", "Full Stack Engineer", "Systems Architect"],
    "description": pageDescription,
    "email": "mailto:noureddinedriouech.contact@gmail.com",
    "nationality": "Moroccan",
    "worksFor": [
      {
        "@type": "Organization",
        "name": "FEV North Africa",
        "url": "https://fev.com"
      }
    ],
    "alumniOf": [
      {
        "@type": "CollegeOrUniversity",
        "name": "National Higher School of Artificial Intelligence and Data Sciences (ENSIASD)",
        "url": "http://ensiasd.uiz.ac.ma"
      },
      {
        "@type": "CollegeOrUniversity",
        "name": "Higher School of Technology (EST Sidi Bennour) - Chouaib Doukkali University",
        "url": "http://www.estsb.ucd.ac.ma"
      }
    ],
    "sameAs": [
      "https://www.linkedin.com/in/noureddinedriouech/",
      "https://github.com/NoureddineDRIOUECH",
      "https://www.upwork.com/freelancers/~01c6fba5436d52831a",
      "https://www.instagram.com/noureddine.driouech/"
    ],
    "knowsAbout": [
      "Artificial Intelligence",
      "Retrieval-Augmented Generation (RAG)",
      "Large Language Models (LLMs)",
      "Local AI / Offline LLMs",
      "Machine Learning",
      "Deep Learning",
      "PyTorch",
      "Vector Databases (FAISS, Chroma DB)",
      "LangChain",
      "LlamaIndex",
      "Full-Stack Development",
      "React.js",
      "Next.js",
      "TypeScript",
      "Python",
      "Tailwind CSS",
      "React Native",
      "SaaS Architecture",
      "Web Automation",
      "Selenium",
      "Technical SEO"
    ],
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Casablanca",
      "addressRegion": "Casablanca-Settat",
      "addressCountry": "MA"
    }
  },
  {
    "@type": "WebSite",
    "@id": `${SITE_URL}/#website`,
    "url": `${SITE_URL}/`,
    "name": "Noureddine Driouech Portfolio",
    "description": pageDescription,
    "publisher": {
      "@id": `${SITE_URL}/#person`
    },
    "inLanguage": "en-US"
  },
  {
    "@type": "ProfilePage",
    "@id": `${pageCanonical}#profilepage`,
    "url": pageCanonical,
    "name": pageTitle,
    "isPartOf": {
      "@id": `${SITE_URL}/#website`
    },
    "about": {
      "@id": `${SITE_URL}/#person`
    },
    "mainEntity": {
      "@id": `${SITE_URL}/#person`
    }
  }
];

// Add FAQPage Schema if faqs prop provided
if (faqs && faqs.length > 0) {
  schemaGraph.push({
    "@type": "FAQPage",
    "@id": `${pageCanonical}#faq`,
    "mainEntity": faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  });
}

// Add BreadcrumbList Schema if breadcrumbs prop provided
if (breadcrumbs && breadcrumbs.length > 0) {
  schemaGraph.push({
    "@type": "BreadcrumbList",
    "@id": `${pageCanonical}#breadcrumb`,
    "itemListElement": breadcrumbs.map((crumb, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": crumb.name,
      "item": crumb.url.startsWith("http") ? crumb.url : `${SITE_URL}${crumb.url}`
    }))
  });
}

const isAdPage = Astro.url.pathname.match(/^\/blog\/.+/);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={pageKeywords} />
    <meta name="author" content="Noureddine Driouech" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={pageCanonical} />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/NoureddineDRIOUECH.webp" type="image/webp" />
    <meta name="generator" content={Astro.generator} />

    <!-- AI & LLM Machine-Readable Endpoint Links -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Summary Manifest" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Complete LLM Knowledge Base" />

    <!-- Google Fonts Preconnect & Optimized Loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:site_name" content="Noureddine Driouech" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={pageImage} />
    <meta property="og:image:alt" content="Noureddine Driouech - AI Software Engineer" />
    <meta property="og:locale" content="en_US" />

    {type === "article" && publishDate && (
      <meta property="article:published_time" content={publishDate.toISOString()} />
    )}
    {type === "article" && updatedDate && (
      <meta property="article:modified_time" content={updatedDate.toISOString()} />
    )}
    {type === "article" && (
      <meta property="article:author" content="Noureddine Driouech" />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageCanonical} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={pageImage} />
    <meta name="twitter:image:alt" content="Noureddine Driouech - AI Software Engineer" />

    <!-- Unified JSON-LD Schema Graph -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": schemaGraph
    })} />

    <!-- Zero-Flash Theme Initialization Script -->
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
          return localStorage.getItem("theme");
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      };
      const isDark = getThemePreference() === "dark";
      document.documentElement.classList[isDark ? "add" : "remove"]("dark");

      if (typeof window !== "undefined") {
        window.addEventListener("DOMContentLoaded", () => {
          if (typeof localStorage !== "undefined") {
            const observer = new MutationObserver(() => {
              const isDark = document.documentElement.classList.contains("dark");
              localStorage.setItem("theme", isDark ? "dark" : "light");
            });
            observer.observe(document.documentElement, {
              attributes: true,
              attributeFilter: ["class"],
            });
          }
        });
      }
    </script>

    <!-- Google Analytics (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-E4HT3W4JFD" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-E4HT3W4JFD', { anonymize_ip: true });
    </script>

    {isAdPage && (
      <script
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9844566788252616"
        crossorigin="anonymous"
        is:inline
      ></script>
    )}
  </head>
  <body class="bg-background text-foreground antialiased selection:bg-foreground selection:text-background min-h-screen">
    <DockBar client:visible />
    <slot />
    {
      showEffects && (
        <>
          <StarsCanvas client:idle />
          <SplashCursor DYE_RESOLUTION={512} SHADING={false} client:idle />
        </>
      )
    }
    <ScrollProgress client:visible />
    <Toaster client:idle />

    <SpeedInsights />
    <Analytics />
  </body>
</html>
