---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { FooterSection } from '@/components/home_sections/FooterSection';
import { formatDate, getReadingTime } from '@/lib/reading-time';
import { ArrowUpRight, Clock, Sparkles, Search, Layers, BookOpen, Bot } from 'lucide-react';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

const posts = allPosts.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPost = posts[0];
const standardPosts = posts.slice(1);

// Curated primary category taxonomy
const categories = [
	{ id: "all", label: "All Publications" },
	{ id: "ai-rag", label: "AI & RAG Systems", filterTag: "RAG" },
	{ id: "saas", label: "SaaS Architecture", filterTag: "SaaS" },
	{ id: "automation", label: "Web Automation", filterTag: "Automation" },
	{ id: "fullstack", label: "TypeScript & Full-Stack", filterTag: "TypeScript" }
];
---

<Layout
	title="Publications & Engineering Insights"
	description="In-depth technical publications, AI architecture blueprints, and engineering notes on Local RAG, LLMs, Next.js SaaS, and automation by Noureddine Driouech."
	breadcrumbs={[
		{ name: "Home", url: "/" },
		{ name: "Blog", url: "/blog/" }
	]}
	keywords="AI Engineering Blog, Local RAG Systems, AI Agents, Next.js Architecture, Python Automation, Noureddine Driouech Publications"
>
	<main class="w-full min-h-screen pt-28 pb-16">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			{/* Editorial Header */}
			<div class="space-y-4 pb-10 text-left border-b border-border/50">
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full glass-pill text-xs font-mono font-semibold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">
					<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 beacon-pulse inline-block" />
					<span>Engineering & Systems Research</span>
				</div>
				<h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-foreground">
					Publications
				</h1>
				<p class="text-base sm:text-lg text-muted-foreground max-w-2xl leading-relaxed">
					Deep-dive technical blueprints, case studies, and production patterns spanning Local RAG systems, AI agents, full-stack SaaS engineering, and resilient automation.
				</p>
			</div>

			{/* Documentation-Grade Filter & Search Console */}
			<div class="my-8 space-y-4">
				{/* Search Bar */}
				<div class="relative flex items-center w-full px-4 py-3 rounded-2xl glass-panel border border-border/70 focus-within:border-foreground/40 transition-all shadow-sm gap-3">
					<Search class="w-4 h-4 text-muted-foreground flex-shrink-0" />
					<input
						type="text"
						id="pub-search"
						placeholder="Search publications by keyword, architecture, or technology..."
						class="w-full bg-transparent text-sm text-foreground placeholder:text-muted-foreground focus:outline-none border-none p-0"
					/>
				</div>

				{/* Category Segmented Bar */}
				<div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1">
					{categories.map((cat, idx) => (
						<button
							class={`category-tab px-4 py-2 rounded-xl text-xs font-semibold tracking-wide transition-all duration-200 cursor-pointer whitespace-nowrap border ${
								idx === 0
									? "bg-foreground text-background border-foreground shadow-sm"
									: "text-muted-foreground hover:text-foreground border-border/60 glass-pill"
							}`}
							data-filter={cat.id}
							data-tag={cat.filterTag ?? ""}
						>
							{cat.label}
						</button>
					))}
				</div>
			</div>

			{/* Featured Flagship Article */}
			{featuredPost && (
				<div id="featured-wrapper" class="mb-12 publication-card" data-tags={(featuredPost.data.tags ?? []).join(",")} data-title={featuredPost.data.title.toLowerCase()} data-desc={featuredPost.data.description.toLowerCase()}>
					<a
						href={`/blog/${featuredPost.id}`}
						class="group relative block rounded-3xl glass-panel p-6 sm:p-8 lg:p-10 border border-border/70 hover:border-foreground/30 transition-all duration-500 hover:shadow-2xl overflow-hidden"
					>
						<div class="grid lg:grid-cols-12 gap-8 items-center">
							{/* Featured Image */}
							<div class="lg:col-span-6 relative aspect-[16/10] w-full rounded-2xl overflow-hidden bg-black/30 border border-border/60 flex items-center justify-center p-3">
								<img
									src={featuredPost.data.heroImage || "/NoureddineDRIOUECH.jpg"}
									alt={featuredPost.data.title}
									class="w-full h-full object-contain object-center transition-transform duration-700 group-hover:scale-105"
								/>
								<div class="absolute top-3 left-3">
									<span class="px-3 py-1 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider bg-emerald-500/90 text-white shadow-sm flex items-center gap-1.5">
										<Sparkles class="w-3 h-3" />
										Featured Blueprint
									</span>
								</div>
							</div>

							{/* Featured Content */}
							<div class="lg:col-span-6 space-y-4">
								<div class="flex items-center gap-3 text-xs font-mono text-muted-foreground">
									<time datetime={featuredPost.data.pubDate.toISOString()}>
										{formatDate(featuredPost.data.pubDate)}
									</time>
									<span>·</span>
									<span class="flex items-center gap-1 text-emerald-500 font-semibold">
										<Clock class="w-3 h-3" />
										{getReadingTime(featuredPost.body ?? "")} min read
									</span>
								</div>

								<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-foreground group-hover:text-primary transition-colors leading-tight">
									{featuredPost.data.title}
								</h2>

								<p class="text-sm sm:text-base text-muted-foreground leading-relaxed line-clamp-3">
									{featuredPost.data.description}
								</p>

								<div class="pt-4 flex items-center justify-between">
									<div class="flex flex-wrap gap-1.5">
										{(featuredPost.data.tags ?? []).slice(0, 3).map((tag) => (
											<span class="px-2.5 py-1 rounded-lg text-[11px] font-medium bg-muted/60 text-muted-foreground border border-border/40">
												#{tag}
											</span>
										))}
									</div>

									<div class="inline-flex items-center gap-1 text-xs font-bold text-foreground group-hover:text-primary transition-colors">
										<span>Read Blueprint</span>
										<ArrowUpRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
									</div>
								</div>
							</div>
						</div>
					</a>
				</div>
			)}

			{/* Articles Grid */}
			<div id="posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
				{standardPosts.map((post) => (
					<article
						class="publication-card group relative flex flex-col justify-between rounded-2xl glass-panel p-6 border border-border/70 hover:border-foreground/30 transition-all duration-500 hover:shadow-xl hover:-translate-y-1"
						data-tags={(post.data.tags ?? []).join(",")}
						data-title={post.data.title.toLowerCase()}
						data-desc={post.data.description.toLowerCase()}
					>
						<a href={`/blog/${post.id}`} class="flex flex-col flex-1 justify-between space-y-4">
							<div class="space-y-3">
								<div class="flex items-center justify-between text-xs font-mono text-muted-foreground">
									<time datetime={post.data.pubDate.toISOString()}>
										{formatDate(post.data.pubDate)}
									</time>
									<span class="flex items-center gap-1">
										<Clock class="w-3 h-3 text-emerald-500" />
										{getReadingTime(post.body ?? "")}m
									</span>
								</div>

								<h3 class="text-lg font-bold tracking-tight text-foreground group-hover:text-primary transition-colors leading-snug">
									{post.data.title}
								</h3>

								<p class="text-xs sm:text-sm text-muted-foreground leading-relaxed line-clamp-3">
									{post.data.description}
								</p>
							</div>

							<div class="pt-4 border-t border-border/40 flex items-center justify-between">
								<div class="flex flex-wrap gap-1">
									{(post.data.tags ?? []).slice(0, 2).map((tag) => (
										<span class="px-2 py-0.5 rounded-md text-[10px] font-medium bg-muted/60 text-muted-foreground">
											#{tag}
										</span>
									))}
								</div>
								<span class="text-xs font-semibold text-foreground group-hover:text-primary flex items-center gap-0.5">
									<span>Read</span>
									<ArrowUpRight class="w-3.5 h-3.5" />
								</span>
							</div>
						</a>
					</article>
				))}
			</div>

			{/* Empty State */}
			<div id="empty-state" class="text-center py-20 hidden">
				<p class="text-base text-muted-foreground">No publications found matching your filter or search query.</p>
			</div>
		</div>

		<div class="mt-20">
			<FooterSection client:visible />
		</div>
	</main>
</Layout>

<script>
	const tabs = document.querySelectorAll<HTMLButtonElement>(".category-tab");
	const cards = document.querySelectorAll<HTMLElement>(".publication-card");
	const searchInput = document.getElementById("pub-search") as HTMLInputElement | null;
	const emptyState = document.getElementById("empty-state");

	let currentTag = "";
	let searchQuery = "";

	function applyFilter() {
		let matchCount = 0;

		cards.forEach((card) => {
			const tags = card.dataset.tags?.split(",") ?? [];
			const title = card.dataset.title ?? "";
			const desc = card.dataset.desc ?? "";

			const matchesCategory = currentTag === "" || tags.some(t => t.toLowerCase().includes(currentTag.toLowerCase()));
			const matchesSearch = searchQuery === "" || title.includes(searchQuery) || desc.includes(searchQuery) || tags.some(t => t.toLowerCase().includes(searchQuery));

			const isVisible = matchesCategory && matchesSearch;
			card.style.display = isVisible ? "" : "none";
			if (isVisible) matchCount++;
		});

		if (emptyState) {
			emptyState.style.display = matchCount === 0 ? "block" : "none";
		}
	}

	tabs.forEach((tab) => {
		tab.addEventListener("click", () => {
			currentTag = tab.dataset.tag ?? "";

			tabs.forEach((t) => {
				const isSelected = t === tab;
				if (isSelected) {
					t.className = "category-tab px-4 py-2 rounded-xl text-xs font-semibold tracking-wide transition-all duration-200 cursor-pointer whitespace-nowrap border bg-foreground text-background border-foreground shadow-sm";
				} else {
					t.className = "category-tab px-4 py-2 rounded-xl text-xs font-medium text-muted-foreground hover:text-foreground border-border/60 glass-pill transition-all duration-200 cursor-pointer whitespace-nowrap border";
				}
			});

			applyFilter();
		});
	});

	if (searchInput) {
		searchInput.addEventListener("input", (e) => {
			searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
			applyFilter();
		});
	}
</script>
