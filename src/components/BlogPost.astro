---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/lib/reading-time';
import { ArrowUpRight, Clock, Tag } from 'lucide-react';

interface Props {
	post: CollectionEntry<'blog'>;
	featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { data } = post;
const readingTime = post.body
	? Math.max(1, Math.ceil(post.body.trim().split(/\s+/).length / 200))
	: 3;
---

<article
	class={`group relative flex flex-col justify-between rounded-2xl glass-panel overflow-hidden border border-border/70 transition-all duration-500 hover:border-foreground/20 hover:shadow-2xl hover:-translate-y-1 ${
		featured ? "md:col-span-2 lg:col-span-3 bg-gradient-to-br from-card/90 via-card/50 to-background" : ""
	}`}
>
	<!-- Top accent hover highlight line -->
	<div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-emerald-500/60 via-primary/40 to-transparent translate-y-[-2px] group-hover:translate-y-0 opacity-0 group-hover:opacity-100 transition-all duration-500 z-10" />

	<a href={`/blog/${post.id}`} class={`flex ${featured ? "flex-col lg:flex-row" : "flex-col"} flex-1 h-full`}>
		<!-- Media Thumbnail Container -->
		<div class={`relative ${featured ? "lg:w-1/2 aspect-[16/10]" : "w-full aspect-[16/10]"} overflow-hidden bg-black/20 dark:bg-black/40 border-b lg:border-b-0 ${featured ? "lg:border-r" : ""} border-border/60 flex items-center justify-center p-2`}>
			{data.heroImage ? (
				<img
					src={data.heroImage}
					alt={data.title}
					class="w-full h-full object-contain object-center transition-transform duration-700 ease-out group-hover:scale-105"
					loading="lazy"
					width={600}
					height={375}
				/>
			) : (
				<div class="w-full h-full flex flex-col items-center justify-center bg-gradient-to-br from-primary/5 via-purple-500/5 to-pink-500/5 p-6 text-center">
					<div class="w-12 h-12 rounded-2xl glass-pill flex items-center justify-center text-primary mb-2">
						<Tag className="w-5 h-5 opacity-70" />
					</div>
					<span class="text-xs font-mono font-semibold text-muted-foreground/80 uppercase tracking-wider">
						Systems & Architecture
					</span>
				</div>
			)}
			<div class="absolute inset-0 bg-gradient-to-t from-background/40 via-transparent to-transparent pointer-events-none" />

			{/* Reading time badge */}
			<div class="absolute top-3 right-3">
				<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-mono font-medium bg-background/90 backdrop-blur-md text-foreground border border-border/80 shadow-sm">
					<Clock className="w-3 h-3 text-emerald-400" />
					<span>{readingTime} min read</span>
				</span>
			</div>
		</div>

		<!-- Content Body -->
		<div class={`p-6 sm:p-7 flex flex-col justify-between flex-1 space-y-4 ${featured ? "lg:p-8" : ""}`}>
			<div class="space-y-3">
				<!-- Meta: Date & Category -->
				<div class="flex items-center gap-3 text-xs text-muted-foreground font-mono">
					<time datetime={data.pubDate.toISOString()}>
						{formatDate(data.pubDate)}
					</time>
					<span class="text-border">·</span>
					<span class="text-emerald-600 dark:text-emerald-400 font-medium">Technical Deep Dive</span>
				</div>

				<!-- Title -->
				<h2 class={`${featured ? "text-xl sm:text-2xl lg:text-3xl" : "text-lg sm:text-xl"} font-bold tracking-tight text-foreground group-hover:text-primary transition-colors leading-snug`}>
					{data.title}
				</h2>

				<!-- Description -->
				<p class="text-sm text-muted-foreground leading-relaxed line-clamp-3">
					{data.description}
				</p>
			</div>

			<!-- Tags & Read Button -->
			<div class="pt-4 border-t border-border/60 flex items-center justify-between gap-4">
				{data.tags && data.tags.length > 0 ? (
					<div class="flex flex-wrap gap-1.5">
						{data.tags.slice(0, 3).map((tag) => (
							<span class="px-2.5 py-0.5 rounded-lg text-[10px] sm:text-[11px] font-medium bg-muted/60 text-muted-foreground border border-border/40">
								#{tag}
							</span>
						))}
						{data.tags.length > 3 && (
							<span class="px-2 py-0.5 rounded-lg text-[10px] font-medium bg-muted/40 text-muted-foreground">
								+{data.tags.length - 3}
							</span>
						)}
					</div>
				) : <div />}

				<div class="inline-flex items-center gap-1 text-xs font-semibold text-foreground group-hover:text-primary group-hover:translate-x-0.5 transition-all flex-shrink-0">
					<span>Read Article</span>
					<ArrowUpRight className="w-3.5 h-3.5" />
				</div>
			</div>
		</div>
	</a>
</article>
